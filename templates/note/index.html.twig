{% extends 'base.html.twig' %}

{% block title %}Carnet de notes{% endblock %}

{% block body %}
    <h1>Carnet de notes</h1>

    <p><a class="btn" href="{{ path('app_note_new') }}">Nouvelle note</a></p>

    {% if notes is empty %}
        <p>Aucune note pour le moment.</p>
    {% else %}
        <ul class="notes">
        {% for note in notes %}
            <li>
                <a href="{{ path('app_note_show', {'id': note.id}) }}">{{ note.title }}</a>
                <small>{{ note.createdAt|date('d/m/Y H:i') }}</small>
            </li>
        {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
